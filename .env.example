# Public path prefix when the app is hosted under a subpath.
# GitHub Pages for this repo uses /llm-workbench/
# Local development and Docker should keep this as /
NUXT_APP_BASE_URL=/

# Enable Nuxt DevTools in local development (true/false).
# Set false in CI, Docker, and production builds.
NUXT_DEVTOOLS=false

# GitHub Actions sets CI=true automatically. Node / Vitest / Playwright / Nuxt
# treat it as “non-interactive” (e.g. Playwright retries, forbidOnly).
# Leave unset for local runs; uncomment only when mimicking CI.
# CI=true

# Set by the CI workflow for scripts/check-dco.mjs; leave unset locally unless mimicking CI.
# BASE=
# Set by the CI workflow for scripts/check-dco.mjs; leave unset locally unless mimicking CI.
# HEAD=
# GitHub Actions sets this automatically; scripts/test-offline.mjs uses it for CI-only behavior.
# Leave unset locally unless mimicking GitHub Actions.
# GITHUB_ACTIONS=

# Bind address and port for the Nitro/Node server (Docker Compose / Dockerfile).
# Compose injects HOST=0.0.0.0 and PORT=3000 so the container is reachable.
# Local `npm run dev` defaults to localhost:3000 without these — leave commented
# unless you need to override the bind address.
# HOST=0.0.0.0
# PORT=3000

# Node environment. Docker sets production; leave unset for local `npm run dev`.
# NODE_ENV=production

# Optional. Provider keys for code-exporter snippets / local tooling.
# The workbench stores keys in the encrypted Settings vault by default;
# these env vars are NOT required to run `npm run dev`.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Public Sentry DSN for browser error tracking (SPA).
# Leave empty for local/dev — the client plugin no-ops without a DSN.
# https://docs.sentry.io/platforms/javascript/
NUXT_PUBLIC_SENTRY_DSN=
